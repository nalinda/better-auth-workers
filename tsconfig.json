{
  "compilerOptions": {
    "target": "ES2025",
    "lib": ["ES2025"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun", "@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "better-auth-workers": ["./src/index.ts"],
      "better-auth-workers/client": ["./src/client.ts"],
      "better-auth-workers/admin": ["./src/admin.ts"]
    }
  },
  "include": ["src/**/*.ts", "examples/**/*.ts", "test/**/*.ts"]
}
