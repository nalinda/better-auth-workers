{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "example-hono-api",
  "main": "src/api.ts",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat"],
  // The service binding targets the auth Worker by its environment-specific
  // name (`example-hono-d1` / `example-hono-hyperdrive`), and the KV
  // namespace is the same one the auth Worker uses, so sign-out on the auth
  // Worker is visible to this Worker's session cache.
  "env": {
    "d1": {
      "kv_namespaces": [
        {
          "binding": "AUTH_KV",
          "id": "example-auth-kv-id",
        },
      ],
      "services": [
        {
          "binding": "AUTH",
          "service": "example-hono-d1",
        },
      ],
    },
    "hyperdrive": {
      "kv_namespaces": [
        {
          "binding": "AUTH_KV",
          "id": "example-auth-kv-id",
        },
      ],
      "services": [
        {
          "binding": "AUTH",
          "service": "example-hono-hyperdrive",
        },
      ],
    },
  },
}
