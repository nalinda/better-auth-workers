{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "example-hono",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat"],
  // BETTER_AUTH_SECRET is a secret, not a var: locally it comes from
  // .dev.vars (see README), deployed it is set with `wrangler secret put`.
  //
  // The top-level environment has no database binding: run and deploy with
  // `--env d1` or `--env hyperdrive` (the package.json scripts do), which
  // add `DB` or `HYPERDRIVE` to what is shared here.
  "kv_namespaces": [
    {
      "binding": "AUTH_KV",
      "id": "example-auth-kv-id",
    },
  ],
  "vars": {
    "AUTH_BASE_URL": "http://localhost:8787",
  },
  "env": {
    "d1": {
      "vars": {
        "AUTH_BASE_URL": "http://localhost:8787",
      },
      "kv_namespaces": [
        {
          "binding": "AUTH_KV",
          "id": "example-auth-kv-id",
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "example-auth-db",
          "database_id": "example-auth-db-id",
        },
      ],
    },
    "hyperdrive": {
      "vars": {
        "AUTH_BASE_URL": "http://localhost:8787",
      },
      "kv_namespaces": [
        {
          "binding": "AUTH_KV",
          "id": "example-auth-kv-id",
        },
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "example-hyperdrive-id",
          "localConnectionString": "postgresql://postgres:postgres@localhost:5432/auth_example",
        },
      ],
    },
  },
}
